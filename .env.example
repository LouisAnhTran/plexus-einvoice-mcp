# ─────────────────────────────────────────────────────────────────────────────
#  einvoice-mcp — MCP server wrapping the e-invoice Access Point API
#
#  Copy to .env for local development:   cp .env.example .env
#
#  Real environment variables override this file, so a container platform can
#  inject them directly and ship no .env at all.
# ─────────────────────────────────────────────────────────────────────────────

# Where the Access Point API lives.
#   local dev        http://localhost:8100
#   docker compose   http://einvoice-api:8100
#   kubernetes       http://einvoice-api.default.svc.cluster.local:8100
EINVOICE_API_BASE_URL=http://localhost:8100

# MUST match einvoice-api's EINVOICE_API_KEY exactly — it is a shared secret,
# sent as the X-Api-Key header. A mismatch makes every tool fail with 401.
# This server holds no database credentials; this key is its only secret.
EINVOICE_API_KEY=dev-smp-key

# Per-request timeout calling the API, in seconds.
EINVOICE_API_TIMEOUT_SECONDS=15

# Where this MCP server listens. Use 0.0.0.0 in a container.
MCP_HOST=127.0.0.1
MCP_PORT=9000
